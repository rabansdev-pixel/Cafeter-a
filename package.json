{
  "name": "cafeteria-frontend-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-isolation=none tests/js/*.test.js",
    "test:coverage": "c8 --all --include 'app/static/js/**/*.js' --reporter=text --reporter=lcov --reporter=json-summary --reports-dir=coverage-js npm test",
    "build:admin": "node scripts/build-admin.mjs",
    "build:auth": "node scripts/build-auth.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "c8": "12.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  }
}
