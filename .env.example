# ==============================================================================
# CONFIGURACIÓN DE ENTORNO DE LA CAFETERÍA
# ==============================================================================
# Opciones para APP_ENV: development | testing | production
APP_ENV=development

# Clave secreta para sesiones y CSRF
SECRET_KEY=dev-artisan-roast-super-secret-key-change-in-prod

# Configuración de Base de Datos
# En dev: sqlite:///dev_cafe.db
# En test: sqlite:///:memory:
# En prod: postgresql://cafe_user:secure_password@db:5432/cafe_db
DATABASE_URL=sqlite:///dev_cafe.db

# Configuración del Servidor
PORT=5000
HOST=0.0.0.0

# Parámetros de SonarQube (para integración CI/CD o local)
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=sqp_sample_token_here
