# ==============================================================================
# CONFIGURACIÓN DE ENTORNO DE LA CAFETERÍA
# ==============================================================================
# Opciones para APP_ENV: development | testing | production
APP_ENV=development

# Generar una clave aleatoria propia de al menos 32 caracteres. No compartirla.
SECRET_KEY=

# PostgreSQL solamente: URL pública en local; URL interna dentro de Railway.
# Ambas deben apuntar a la misma base. Nunca guardar credenciales en Git.
DATABASE_URL=

# Configuración del Servidor
PORT=5000
HOST=0.0.0.0

# Parámetros de SonarQube (para integración CI/CD o local)
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=sqp_sample_token_here

# Autenticación Firebase: usa los valores de tu propia app web.
AUTH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
